# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
MONGODB_DB=redirector


# Dashboard login
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Signs login cookies and hashes visitor IDs. Keep it secret; changing it logs you out.
SESSION_SECRET=generate-a-long-random-string

# Time zone used for daily/hourly analytics buckets
ANALYTICS_TZ=Asia/Karachi
